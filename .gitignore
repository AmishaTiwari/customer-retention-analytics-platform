# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editor/OS
.vscode/
.DS_Store
.claude/

# Raw source data is intentionally version-controlled.
# Intermediate and processed data are regenerated by the pipeline.
# Keep .gitkeep files so the directory structure remains visible.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated model artifacts are not version-controlled.
# Keep .gitkeep files so the directory structure remains visible.
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep

# Generated evaluation artifacts and outputs are ignored by default.
# Keep .gitkeep files so the directory structure remains visible.
artifacts/evaluation/*
!artifacts/evaluation/.gitkeep
outputs/*
!outputs/.gitkeep
