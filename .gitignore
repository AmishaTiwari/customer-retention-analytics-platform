# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editor/OS
.vscode/
.DS_Store
.claude/

# Data directories are git-ignored (reproducible from source, not committed),
# but .gitkeep files are kept tracked so the folder structure stays visible on GitHub.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Artifacts are regenerated by the training/evaluation stages and not committed.
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep

# Evaluation artifacts and outputs are ignored by default.
# Selected final artifacts referenced in the README (e.g., evaluation plots
# and comparison tables) may be committed later when they are generated.
artifacts/evaluation/*
!artifacts/evaluation/.gitkeep
outputs/*
!outputs/.gitkeep
